## 15. Practice Exercises

Try solving these without looking at the solutions first.

### Exercise 1 — Read an input

Create a text input and a button. When the button is clicked, display the entered value in a paragraph.

**Solution:**

```html
<input type="text" id="name">
<button type="button" id="show">Show</button>
<p id="result"></p>

<script>
    const nameInput = document.getElementById("name");
    const button = document.getElementById("show");
    const result = document.getElementById("result");

    button.addEventListener("click", function () {
        result.textContent = nameInput.value;
    });
</script>
```

### Exercise 2 — Check a checkbox

Create a checkbox for accepting terms. Display `Accepted` when selected and `Not accepted` otherwise.

**Solution:**

```javascript
const terms = document.getElementById("terms");

if (terms.checked) {
    console.log("Accepted");
} else {
    console.log("Not accepted");
}
```

### Exercise 3 — Validate an email

Create an email input and check its validity when a button is clicked.

**Solution:**

```html
<input type="email" id="email">
<button type="button" id="check">Check</button>

<script>
    const email = document.getElementById("email");

    document.getElementById("check").addEventListener("click", function () {

        if (email.validity.valid && email.value !== "") {
            console.log("Valid email");
        } else {
            console.log("Invalid email");
        }

    });
</script>
```

### Exercise 4 — Password confirmation

Create two password inputs. Display a message if they do not match.

**Solution:**

```javascript
const password = document.getElementById("password").value;
const confirmPassword =
    document.getElementById("confirmPassword").value;

if (password === confirmPassword) {
    console.log("Passwords match");
} else {
    console.log("Passwords do not match");
}
```

### Exercise 5 — Collect form data

Create a form with name and email inputs. Use `FormData` to read both values when submitted.

**Solution:**

```javascript
const form = document.getElementById("myForm");

form.addEventListener("submit", function (event) {

    event.preventDefault();

    const data = new FormData(form);

    console.log(data.get("name"));
    console.log(data.get("email"));

});
```

